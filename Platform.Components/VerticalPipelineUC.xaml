<local:ComponentBase x:Class="Platform.Components.VerticalPipelineUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Platform.Components"
             mc:Ignorable="d" 
             x:Name="component"
             d:DesignHeight="450" d:DesignWidth="50">

    <local:ComponentBase.Resources>
        <BooleanToVisibilityConverter x:Key="b2v"/>

        <Style TargetType="Button" x:Key="DeleteButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#55000000" Name="root" CornerRadius="11">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#88000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </local:ComponentBase.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState Name="EWFlowState">
                    <!--向左 东-西-->
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Duration="0:0:1" From="0" To="5" 
                             Storyboard.TargetName="liquidLine"
                             Storyboard.TargetProperty="StrokeDashOffset"/>
                    </Storyboard>
                </VisualState>

                <VisualState Name="WEFlowState">
                    <!--向右-->
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Duration="0:0:1" From="0" To="-5" 
                             Storyboard.TargetName="liquidLine"
                             Storyboard.TargetProperty="StrokeDashOffset"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border CornerRadius="2" Margin="5">
            <Border.Background>
                <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                    <GradientStop Color="#FFCBCBCB" Offset="0.8"/>
                    <GradientStop Color="White" Offset="0.5"/>
                    <GradientStop Color="#FFCBCBCB" Offset="0.1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border Margin="2" Name="border">
                <Line X1="0" Y1="0" X2="0"
               Y2="{Binding ElementName=border,Path=ActualHeight}" Stroke="#9916a1ff"
               StrokeThickness="{Binding ElementName=border,Path=ActualWidth}" StrokeDashArray="2,3" 
               StrokeDashCap="Round" Stretch="Fill" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
               HorizontalAlignment="Center" Name="liquidLine" Opacity="0.3"/>
            </Border>
        </Border>

        <!--选中了边框-->
        <Grid Visibility="{Binding IsSelected,Converter={StaticResource b2v}, ElementName=component}">
            <Rectangle Stroke="#AAA" StrokeDashArray="3,3" RadiusX="5" RadiusY="5"/>

            <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Center" HorizontalAlignment="Right" Stroke="#AAA" Margin="-5" Cursor="SizeWE" MouseLeftButtonDown="Ellipse_MouseLeftButtonDown" MouseMove="Ellipse_MouseMove" MouseLeftButtonUp="Ellipse_MouseLeftButtonUp"/>

            <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Bottom" HorizontalAlignment="Right"
Stroke="#AAA" Margin="-5" Cursor="SizeNWSE"  MouseLeftButtonDown="Ellipse_MouseLeftButtonDown"  MouseMove="Ellipse_MouseMove" MouseLeftButtonUp="Ellipse_MouseLeftButtonUp"/>

            <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Bottom" HorizontalAlignment="Center"  Stroke="#AAA" Margin="-5" Cursor="SizeNS"  MouseLeftButtonDown="Ellipse_MouseLeftButtonDown" MouseMove="Ellipse_MouseMove" MouseLeftButtonUp="Ellipse_MouseLeftButtonUp"/>
        </Grid>

        <!--右上角删除按钮-->
        <Button Margin="0,0,-25,0" Visibility="{Binding IsSelected,Converter={StaticResource b2v}, ElementName=component}" VerticalAlignment="Top" HorizontalAlignment="Right" Style="{StaticResource DeleteButtonStyle}" Height="22" Width="22" Click="Delete_Click">
            <Grid Width="12" Height="12">
                <Path Data="M0 0 10 10M10 0 0 10" Stroke="Red" StrokeThickness="1" Stretch="Fill"/>
            </Grid>
        </Button>
    </Grid>
</local:ComponentBase>
