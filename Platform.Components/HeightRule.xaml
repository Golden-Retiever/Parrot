<UserControl x:Class="Platform.Components.HeightRule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Platform.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Line X1="0" Y1="0" X2="20" Y2="0" Height="1" Stroke="Orange" StrokeDashArray="3,3" ClipToBounds="True"/>

        <Line X1="0" Y1="0" X2="0"  Y2="{Binding RelativeSource={RelativeSource Self},Path=ActualHeight}" Width="1" Stroke="Orange"  ClipToBounds="True" Grid.Row="1" HorizontalAlignment="Center"  StrokeDashArray="3,3"/>
        
        <Line X1="0" Y1="0" X2="20" Y2="0" Height="1" Stroke="Orange" StrokeDashArray="3,3" ClipToBounds="True" Grid.Row="2"/>

    </Grid>
</UserControl>
