<?xml version="1.0" encoding="utf-8" ?>
<!-- 
  NLog 核心配置文件
  编码：UTF-8（确保中文日志正常显示）
  适用场景：.NET Framework/.NET Core/.NET 5+ 所有版本
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log"
      internalLogToConsole="false">

	<!-- 变量定义：复用常用路径/格式，简化配置 -->
	<variable name="logDirectory" value="${basedir}/logs" />
	<variable name="archiveDirectory" value="${logDirectory}/archive" />
	<!-- 通用日志格式：时间 | 级别 | 日志器 | 线程ID | 消息 | 异常 -->
	<variable name="commonLayout" value="${longdate:universalTime=false} | ${level:uppercase=true:padding=5} | ${logger:shortName=true} | ${threadid:padding=4} | ${message} ${exception:format=ToString,StackTrace:innerFormat=ToString:maxInnerExceptionLevel=10:separator=\r\n}" />
	<!-- 控制台简化格式：无线程ID，更简洁 -->
	<variable name="consoleLayout" value="${longdate} [${level:uppercase=true}] ${logger:shortName=true} - ${message}" />

	<!-- 目标（Targets）：定义日志输出的目的地 -->
	<targets async="true">
		<!-- async=true：异步写入，提升程序性能（生产必开） -->

		<!-- 目标1：控制台输出（开发环境常用） -->
		<target
			name="consoleTarget"
			xsi:type="Console"
			layout="${consoleLayout}"
			encoding="utf-8" />
		

		<!-- 目标2：调试器输出（VS的“输出窗口”，仅开发调试用） -->
		<target
			name="debuggerTarget"
			xsi:type="Debugger"
			layout="${commonLayout}" />

		
		<!-- 目标3：按时间+大小双规则分割的文件日志（生产核心） -->
		<target
			name="fileTarget"
			xsi:type="File"
			fileName="${logDirectory}/app-${shortdate}.log"
			archiveFileName="${archiveDirectory}/app-${shortdate}-{#}.log"
			archiveEvery="Day"
			archiveDateFormat="yyyyMMdd"    
			archiveAboveSize="10485760"  
			archiveNumbering="Rolling"
			maxArchiveFiles="90"   
			maxArchiveDays="90"          
			encoding="utf-8"
			createDirs="true"
			layout="${commonLayout}"
			keepFileOpen="false"
			openFileCacheTimeout="30"      
			lineEnding="Default" />

		
		<!-- 目标4：仅记录Error/Fatal级别的错误日志（单独文件，便于排查） -->
		<target
			name="errorFileTarget"
			xsi:type="File"
			fileName="${logDirectory}/errors/app-error-${shortdate}.log"
			archiveFileName="${archiveDirectory}/errors/app-error-${shortdate}-{#}.log"
			archiveEvery="Day"
			archiveAboveSize="5242880"
			archiveNumbering="Rolling"
			maxArchiveFiles="30"     
			encoding="utf-8"
			layout="${commonLayout}" />

			<!-- 数据库目标(写SQL Server LogDB库,库未部署,暂时注释;启用时去掉本行上下两端的注释符)
			<target
			  name="databaseTarget"
			  xsi:type="Database"
			  connectionString="Server=.;Database=LogDB;Integrated Security=True;"
			  commandText="INSERT INTO Logs (LogTime, Level, Logger, Message, Exception, ThreadId) VALUES (@LogTime, @Level, @Logger, @Message, @Exception, @ThreadId)">

			<parameter name="@LogTime" layout="${longdate}" />
			<parameter name="@Level" layout="${level}" />
			<parameter name="@Logger" layout="${logger}" />
			<parameter name="@Message" layout="${message}" />
			<parameter name="@Exception" layout="${exception:format=ToString}" />
			<parameter name="@ThreadId" layout="${threadid}" />
		</target>
		-->


	</targets>

	<!-- 规则（Rules）：定义“哪些日志”输出到“哪些目标” -->
	<rules>
		<!-- 规则1：开发环境调试用 - 所有Debug及以上日志输出到调试器和控制台 -->
		<logger
		  name="*"
		  minlevel="Debug"
		  writeTo="debuggerTarget,consoleTarget"
		  enabled="true" />  <!-- 生产环境可设为false禁用 -->

		<!-- 规则2：核心业务日志 - 所有Info及以上日志输出到通用文件 -->
		<logger
		  name="*"
		  minlevel="Info"
		  writeTo="fileTarget"
		  final="false" />  <!-- final=false：允许后续规则继续处理 -->

		<!-- 规则3：错误日志 - 所有Error/Fatal级别日志输出到错误文件（单独存储） -->
		<logger
		  name="*"
		  minlevel="Error"
		  writeTo="errorFileTarget"
		  final="false" />

		<!-- 规则4：特定命名空间过滤 - 排除第三方组件的Debug日志（减少日志量） -->
		<logger
		  name="Microsoft.*"  
		  minlevel="Debug"
		  maxlevel="Debug"
		  final="true" />     <!-- final=true：匹配后不再执行后续规则 -->
		<logger
		  name="System.*"     
		  minlevel="Debug"
		  maxlevel="Debug"
		  final="true" />


		<!-- 兜底规则：所有未匹配的Fatal日志输出到所有目标（避免遗漏严重错误） -->
		<logger
		  name="*"
		  minlevel="Fatal"
		  writeTo="consoleTarget,fileTarget,errorFileTarget"
		  final="true" />
	</rules>

</nlog>