<Window x:Class="Platform.Views.DialogWin.ScenarioNameWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        FontFamily="Microsoft YaHei" FontWeight="ExtraLight" FontSize="12"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Title="{Binding Title}" Height="160" Width="340">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Platform.CommonResource;component/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource App.Foreground}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="3" MinHeight="28" Background="{DynamicResource App.ControlBackground}" Name="bor">
                                <ScrollViewer Name="PART_ContentHost" Margin="5,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bor" Property="BorderBrush" Value="#16a1ff"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!--窗口背景随主题(App.Background 由 ThemeHelper 按明暗切换)-->
    <Grid Background="{DynamicResource App.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!--标题-->
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource App.Foreground}" Margin="10,0"/>

        <!--窗口关闭按钮-->
        <Button VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource WindowControlButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True" Margin="10,0" Content="&#xe653;"
                FontFamily="{StaticResource Iconfont}" Width="30" Height="30" Click="BtnCancel_Click"/>

        <!--名字输入-->
        <TextBox x:Name="txtName" Grid.Row="1" Margin="15,5" KeyDown="TxtName_KeyDown"/>

        <!--确定/取消-->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="确定" Width="100" Height="30" Style="{StaticResource NormalButtonStyle}" Background="#409EFE" Click="BtnOk_Click"/>
            <Button Content="取消" Width="100" Height="30" Margin="15,0,0,0" Style="{StaticResource NormalButtonStyle}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
