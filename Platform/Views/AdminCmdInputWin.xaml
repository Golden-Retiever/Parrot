<Window x:Class="Platform.Views.AdminCmdInputWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理员口令" Width="280" Height="170"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Topmost="True">
    <StackPanel Margin="15">
        <TextBlock Text="请输入管理员口令" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
        <TextBox x:Name="pwdBox" Height="28" VerticalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="60" Height="26" Click="Ok_Click"/>
            <Button Content="取消" Width="60" Height="26" Margin="8,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
