<Window x:Class="Platform.Views.ComponentWin.ComponentEditWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Platform.Views.ComponentWin"
        mc:Ignorable="d" Name="win"
        FontFamily="Microsoft YaHei" FontWeight="ExtraLight" FontSize="11"
        WindowStartupLocation="CenterOwner"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:converter="clr-namespace:Platform.Converter;assembly=Platform.Converter"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="链路编辑" Height="650" Width="1450">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#DCEDfa" Offset="0"/>
            <GradientStop Color="#F7F9FA" Offset="0.1"/>
            <GradientStop Color="#F7F9FA" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="1"/>
    </WindowChrome.WindowChrome>

    <behavior:Interaction.Triggers>
        <behavior:EventTrigger EventName="KeyDown">
            <behavior:InvokeCommandAction Command="{Binding KeyMoveDeviceCommand}" PassEventArgsToCommand="True"></behavior:InvokeCommandAction>
        </behavior:EventTrigger>
    </behavior:Interaction.Triggers>
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Platform.CommonResource;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Platform.CommonResource;component/Styles/ComboBoxStyles.xaml"/>
                <ResourceDictionary>
                    <converter:DeviceConverter x:Key="dc"/>
                    <BooleanToVisibilityConverter x:Key="b2v"/><!--bool类型转成显示枚举值-->
                    
                    <!--切换按钮样式-->
                    <Style TargetType="ToggleButton" x:Key="StateButtonStyle">
                        <Setter Property="Foreground" Value="#AAA"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Name="back" CornerRadius="{Binding Tag,RelativeSource={RelativeSource Mode=TemplatedParent}}">
                                        <Border CornerRadius="{Binding Tag,RelativeSource={RelativeSource Mode=TemplatedParent}}" Name="bor">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Name="content"/>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bor" Property="Background" Value="#09000000"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="back" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                        <GradientStop Color="#AAF7F9FA" Offset="0"/>
                                                        <GradientStop Color="#5DDD" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="content" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="5" Color="Black" ShadowDepth="0" Opacity="0.1"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="Button" x:Key="ControlButtonStyle">
                        <Setter Property="Foreground" Value="#888"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Name="back">
                                        <Border CornerRadius="{Binding Tag,RelativeSource={RelativeSource Mode=TemplatedParent}}" Name="bor">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bor" Property="Background" Value="#09000000"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bor" Property="Background" Value="#11000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--保存视觉状态管理-->
    <VisualStateManager.VisualStateGroups>
        <!--保存成功状态-->
        <VisualStateGroup>
            <VisualState Name="SaveSuccess">
                <Storyboard >
                    <!--处理位置-->
                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="successbox" Storyboard.TargetProperty="Margin">
                        <LinearThicknessKeyFrame Value="0,-80,0,0" KeyTime="0:0:0"/>
                        <LinearThicknessKeyFrame Value="0,20,0,0" KeyTime="0:0:0.3"/>
                        <LinearThicknessKeyFrame Value="0,20,0,0" KeyTime="0:0:3.3"/>
                        <LinearThicknessKeyFrame Value="0,-80,0,0" KeyTime="0:0:4"/>
                    </ThicknessAnimationUsingKeyFrames>

                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="successbox" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.5"/>
                        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:3.5"/>
                        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:4"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </VisualState>

            <!--成功初始状态-->
            <VisualState x:Name="NormalSuccess"/>
        </VisualStateGroup>

        <!--保存失败状态-->
        <VisualStateGroup>
            <VisualState Name="SaveFailedShow">
                <Storyboard >
                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="failedbox" Storyboard.TargetProperty="Margin">
                        <LinearThicknessKeyFrame Value="0,-80,0,0" KeyTime="0:0:0"/>
                        <LinearThicknessKeyFrame Value="0,20,0,0" KeyTime="0:0:0.3"/>
                    </ThicknessAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="failedbox" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.5"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </VisualState>
            
            <VisualState Name="SaveFailedClose">
                <Storyboard >
                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="failedbox" Storyboard.TargetProperty="Margin">
                        <LinearThicknessKeyFrame Value="0,20,0,0" KeyTime="0:0:0"/>
                        <LinearThicknessKeyFrame Value="0,-80,0,0" KeyTime="0:0:0.3"/>
                    </ThicknessAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="failedbox" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0"/>
                        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.3"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </VisualState>
            
            <VisualState Name="SaveFailedNormal"/>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    
    <Grid Background="{DynamicResource App.Background}">
        <Grid.Resources>
            <Style TargetType="ToggleButton" x:Key="ExpanderToggleButton">
                <Setter Property="Foreground" Value="#888"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border CornerRadius="5" Background="Transparent">

                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="Gold" Width="2" Height="10" CornerRadius="2" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3"/>
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="13,0"/>
                                    <TextBlock Text="&#xe6df;" FontFamily="{StaticResource Iconfont}" Grid.Column="1"  VerticalAlignment="Center" HorizontalAlignment="Center"   RenderTransformOrigin="0.5,0.5" Name="arrow"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="arrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Expander">
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border x:Name="Content" BorderThickness="1,0,1,1" CornerRadius="5" Background="#7FFF">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="ContentRow" Height="0" />
                                    </Grid.RowDefinitions>

                                    <ToggleButton  Content="{TemplateBinding Header}" Style="{StaticResource ExpanderToggleButton}" IsChecked="{Binding IsExpanded, Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"/>

                                    <Border Grid.Row="1" BorderBrush="#55409EFE" BorderThickness="0,1,0,0" Margin="10,0"/>
                                    <Border Grid.Row="1" BorderBrush="Orange" BorderThickness="0,1,0,0" Width="20" HorizontalAlignment="Left" Margin="15,0"/>

                                    <ContentPresenter Margin="4" Grid.Row="1" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ContentRow" Property="Height" Value="{Binding Height, ElementName=Content}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource App.Foreground}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="3" MinHeight="26" Background="{DynamicResource App.ControlBackground}" Name="bor">
                                <ScrollViewer Name="PART_ContentHost" Margin="0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bor" Property="BorderBrush" Value="#16a1ff"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToggleButton" x:Key="PointMoreButtonStlye">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border CornerRadius="3" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Name="border">
                                <TextBlock Text="&#xe78d;" FontFamily="{StaticResource Iconfont}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#888"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#EEE"/>
                                    <Setter TargetName="border" Property="Background" Value="#1000"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#EEE"/>
                                    <Setter TargetName="border" Property="Background" Value="#11000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToggleButton" x:Key="ManualToggleButtonStyle">
                <Setter Property="Foreground" Value="#888"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Name="back">
                                <Border CornerRadius="{Binding Tag,RelativeSource={RelativeSource Mode=TemplatedParent}}" Name="bor">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bor" Property="Background" Value="#09000000"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bor" Property="Background" Value="#11000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid>
            <Grid.Background>
                <VisualBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                    <VisualBrush.Visual>
                        <Path Data="M0,0 0,40 40 40" Stroke="#F7F9FA" StrokeThickness="1" StrokeDashArray="5,5"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Grid.Background>
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="Black" Offset="0.6"/>
                </LinearGradientBrush>
            </Grid.OpacityMask>
        </Grid>

        <!--三列-->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#0916a1ff" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <!--第一列 组件列表-->
            <ScrollViewer Background="{DynamicResource App.Background}" HorizontalAlignment="Left" Margin="10,15,0,10" VerticalScrollBarVisibility="Hidden" Visibility="{Binding ElementName=tb_component, Path=IsChecked, Converter={StaticResource b2v}}">
                <ItemsControl ItemsSource="{Binding ComponentTypeList}" Width="150">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding TypeName}" IsExpanded="True">
                                <ItemsControl ItemsSource="{Binding Children}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="35" Height="35"  Background="#09409EFE" Margin="3"  CornerRadius="5" Tag="{Binding}" x:Name="b_1" ToolTip="{Binding ComponentName}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DragDropComCommand}" CommandParameter="{Binding ElementName=b_1}"/>
                                                </Border.InputBindings>
                                                <Border Margin="6">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Icon}"/>
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b_1" Property="Background" Value="#22409EFE"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--第二列 编辑区域-->
            <ItemsControl Grid.Column="1" Margin="5,0" Width="830" Height="550"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          ItemsSource="{Binding DeviceList}" AllowDrop="True"><!--编辑画布=运行时监控可见区(MonitorUC中列830×550),所见即所得-->
                <behavior:Interaction.Triggers>
                    <behavior:EventTrigger EventName="Drop">
                        <behavior:InvokeCommandAction Command="{Binding DeviceDropCommand}" PassEventArgsToCommand="True"></behavior:InvokeCommandAction>
                    </behavior:EventTrigger>
                </behavior:Interaction.Triggers>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <!--布局方式调整-->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="Transparent" ClipToBounds="True">
                            <behavior:Interaction.Triggers>
                                <!--按下鼠标左键-->
                                <behavior:EventTrigger EventName="MouseLeftButtonDown">
                                    <behavior:InvokeCommandAction  Command="{Binding SelectDeviceCommand}"/>
                                </behavior:EventTrigger>
                            </behavior:Interaction.Triggers>
                        </Canvas>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding Path=ComponentType,Converter={StaticResource dc}}" Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="0.5,0.5" Name="content"  Visibility="{Binding IsVisible,Converter={StaticResource b2v}}">

                            <behavior:Interaction.Triggers>
                                <!--按下鼠标左键-->
                                <behavior:EventTrigger EventName="MouseLeftButtonDown">
                                    <!--{Binding}  当前子项对应的数据源，数据源不是集合对象，是集合中对应的子项模型-->
                                    <behavior:CallMethodAction MethodName="OnMouseLeftButtonDown" TargetObject="{Binding}"/>
                                    <behavior:InvokeCommandAction  Command="{Binding DataContext.SelectDeviceCommand,ElementName=win}" CommandParameter="{Binding}"/>
                                </behavior:EventTrigger>

                                <!--鼠标移动-->
                                <behavior:EventTrigger EventName="MouseMove">
                                    <behavior:CallMethodAction MethodName="OnMouseMove" TargetObject="{Binding}"/>
                                </behavior:EventTrigger>

                                <!--松开鼠标左键-->
                                <behavior:EventTrigger EventName="MouseLeftButtonUp">
                                    <behavior:CallMethodAction MethodName="OnMouseLeftButtonUp" TargetObject="{Binding}"/>
                                </behavior:EventTrigger>
                            </behavior:Interaction.Triggers>

                            <!--设备右键菜单-->
                            <ContentControl.ContextMenu>
                                <ContextMenu ItemsSource="{Binding ContextMenus}"/>
                            </ContentControl.ContextMenu>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--第三列 各种配置-->
            <Border Background="{DynamicResource App.Background}" Grid.Column="2" Width="450" HorizontalAlignment="Right" Margin="0,15,10,10" CornerRadius="5" Visibility="{Binding ElementName=tb_property, Path=IsChecked, Converter={StaticResource b2v}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    
                    <!--第一行-->
                    <Border CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7716a1ff" Offset="0"/>
                                <GradientStop Color="#1116a1ff" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Background="Gold" Width="4" Height="10" CornerRadius="2" Margin="10,0,0,0"  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock VerticalAlignment="Center" Foreground="White" Margin="20,0,0,0">
                            <Run Text="参数配置" Foreground="{DynamicResource App.Foreground}"/>
                            <Run Text="{Binding SelectedDevice.DeviceName,StringFormat= - {0}}" FontWeight="Bold"/>
                    </TextBlock>
                    
                    <!--第二行(内容超出一屏时可竖向滚动)-->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <!--#region 通信配置-->
                        <Border CornerRadius="5" Background="#AFFF" Grid.RowSpan="2" Margin="0,5,0,0"/>
                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Margin="10,5,10,8"/>
                        <TextBlock Text="通信参数" Margin="15,10" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding HasDevice}">
                                <TextBlock Text="协议" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource App.Foreground}"/>
                            <ComboBox Width="120" Margin="0,0,10,0"
                                      ItemsSource="{Binding ProtocolOptions}"
                                      SelectedItem="{Binding Protocol}"
                                      Style="{StaticResource PropComboBoxStyle}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Hidden" Margin="10,0,0,5"
                                      IsEnabled="{Binding HasDevice}">
                            <ItemsControl ItemsSource="{Binding SelectedDevice.DevicePropList}" Margin="0,0,10,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26" Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PropTitle}" Foreground="#555" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" Name="cb" Visibility="Collapsed"
                                                      ItemsSource="{Binding ValueOptions}"
                                                      SelectedItem="{Binding PropValue}"
                                                      Style="{StaticResource PropComboBoxStyle}"/>
                                            <TextBox Grid.Column="1" Name="tb" Text="{Binding PropValue, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!--0=文本,1=下拉:行自带 PropType,不再查目录-->
                                            <DataTrigger Binding="{Binding PropType}" Value="1">
                                                <Setter TargetName="cb" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="tb" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <!--空标题=隐藏的Protocol真身行,不渲染-->
                                            <DataTrigger Binding="{Binding PropTitle}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!--#endregion-->

                        <!--#region 变量配置-->
                        <Border CornerRadius="5" Background="#AFFF" Grid.Row="2" Grid.RowSpan="3" Margin="0,5,0,0"
                                Visibility="{Binding ElementName=tb_varConf, Path=IsChecked, Converter={StaticResource b2v}}"/>
                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Margin="10,6,10,8" Grid.Row="2"
                                Visibility="{Binding ElementName=tb_varConf, Path=IsChecked, Converter={StaticResource b2v}}"/>
                        <!--节标题做成开关:勾=显示变量列表,取消勾=折叠(同"手动控制配置"样式)-->
                        <ToggleButton Grid.Row="2" Style="{StaticResource ManualToggleButtonStyle}" Height="32" Margin="5,4" HorizontalContentAlignment="Stretch" Name="tb_varConf" IsChecked="True">
                            <Grid Margin="20,0">
                                <TextBlock Text="变量配置" HorizontalAlignment="Left" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="&#xe720;" FontFamily="{StaticResource Iconfont}" HorizontalAlignment="Left" Margin="46 0"/>
                            </Grid>
                        </ToggleButton>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="5,0" >
                                <TextBlock Text="轮询间隔(ms)" VerticalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                            <TextBox Width="50" Height="20" Margin="5,-1,8,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     ToolTip="本设备变量读取节奏,0/空按500兜底"
                                     Text="{Binding SelectedDevice.RefreshRate}"/>
                            <Button Width="24" Height="24" Style="{StaticResource WindowControlButtonStyle}" ToolTip="添加变量信息" Command="{Binding SelectedDevice.AddVariableCommand}">
                                <Path Data="M0 5 10 5M5 0 5 10" Stroke="#555"/>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="10,0,10,5"
                              Visibility="{Binding ElementName=tb_varConf, Path=IsChecked, Converter={StaticResource b2v}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                                <TextBlock Text="变量名称" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="地址" Grid.Column="1" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="帧" Grid.Column="2" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="4" MaxHeight="200" VerticalScrollBarVisibility="Hidden" Margin="10,-5,0,5"
                                      Visibility="{Binding ElementName=tb_varConf, Path=IsChecked, Converter={StaticResource b2v}}">
                            <ItemsControl ItemsSource="{Binding SelectedDevice.DeviceVarList}" Margin="0,0,10,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1" Name="root">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding VarName}"/>
                                            <TextBox Text="{Binding VarAddress}" Grid.Column="1" HorizontalContentAlignment="Center" Margin="2,0,0,0"/>
                                            <!--裸帧:勾选后地址格填完整请求帧文本,原样收发-->
                                            <CheckBox IsChecked="{Binding IsRawFrame}" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <ToggleButton Grid.Column="3" Name="tb" Margin="3" Style="{StaticResource PointMoreButtonStlye}" Width="20"/>
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Hyperlink FontFamily="{StaticResource Iconfont}" TextDecorations="None" Command="{Binding ElementName=win,Path=DataContext.SelectedDevice.DeleteVariableCommand}" CommandParameter="{Binding}">&#xe653;</Hyperlink>
                                            </TextBlock>

                                            <Popup StaysOpen="False" IsOpen="{Binding ElementName=tb,Path=IsChecked}" PlacementTarget="{Binding ElementName=root}" AllowsTransparency="True" VerticalOffset="2" HorizontalOffset="0">
                                                <Border Background="#F7F9FA" Width="{Binding ElementName=root,Path=ActualWidth}" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1" Margin="3">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="10" Opacity="0.1" Color="Gray" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                    <Grid Grid.Row="3" Margin="10,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="30"/>
                                                            <RowDefinition Height="30"/>
                                                            <RowDefinition Height="30"/>
                                                        </Grid.RowDefinitions>
                                                            <TextBlock Text="数据类型" Foreground="{DynamicResource App.Foreground}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="偏移量" Grid.Row="1" Foreground="{DynamicResource App.Foreground}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="系数" Grid.Row="2" Foreground="{DynamicResource App.Foreground}" VerticalAlignment="Center"/>

                                                        <!--数据类型选项来自 ViewModel 的 TypeList(ElementName 穿透 DataTemplate 到窗口 DataContext)-->
                                                        <ComboBox Height="26" Style="{StaticResource PropComboBoxStyle}"
                                                                  ItemsSource="{Binding ElementName=win, Path=DataContext.TypeList}"
                                                                  SelectedValue="{Binding VarType}" Grid.Column="1"/>
                                                        <TextBox Text="{Binding Offset}" Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBox Text="{Binding Modulus}" Grid.Row="2" Grid.Column="1" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!--#endregion-->

                        <!--#region 手动控制(内嵌显示)-->
                        <Border CornerRadius="5" Background="#AFFF" Grid.Row="5" Grid.RowSpan="4" Margin="0,5,0,37"
                                Visibility="{Binding ElementName=btnManual, Path=IsChecked, Converter={StaticResource b2v}}"/>
                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Margin="10,5,10,8" Grid.Row="5"
                                Visibility="{Binding ElementName=btnManual, Path=IsChecked, Converter={StaticResource b2v}}"/>
                        <ToggleButton Grid.Row="5" Style="{StaticResource ManualToggleButtonStyle}" Height="30" Margin="5,3" HorizontalContentAlignment="Stretch" Tag="5" Name="btnManual" IsChecked="True">
                            <Grid Margin="20,0">
                                <TextBlock Text="手动控制配置" HorizontalAlignment="Left" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="&#xe720;" FontFamily="{StaticResource Iconfont}" HorizontalAlignment="Left" Margin="72 0"/>
                            </Grid>
                        </ToggleButton>
                        <StackPanel Orientation="Horizontal" Grid.Row="5" HorizontalAlignment="Right" Margin="5,0">
                                <Button Width="24" Height="24" Style="{StaticResource WindowControlButtonStyle}" ToolTip="添加手动控制" Command="{Binding SelectedDevice.AddManualControlCommand}" Foreground="{DynamicResource App.Foreground}">
                                <Path Data="M0 5 10 5M5 0 5 10" Stroke="#555"/>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="6" Margin="10,-1,10,5" TextBlock.Foreground="#999"
                              Visibility="{Binding ElementName=btnManual, Path=IsChecked, Converter={StaticResource b2v}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                                <TextBlock Text="控制名称" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="控制地址" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="写入数据" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="延时(ms)" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="帧" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="循环" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="操作" Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="7" MaxHeight="200" VerticalScrollBarVisibility="Hidden" Margin="10,0,0,5"
                                      Visibility="{Binding ElementName=btnManual, Path=IsChecked, Converter={StaticResource b2v}}">
                            <ItemsControl ItemsSource="{Binding SelectedDevice.ManualControlList}" Margin="0,0,10,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="30" Name="root">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ControlName}" Height="28" />
                                            <TextBox Text="{Binding ControlAddress}" Grid.Column="1" Height="28" TextAlignment="Center"/>
                                            <TextBox Text="{Binding ControlValue}" Grid.Column="2" Height="28" TextAlignment="Center"/>
                                            <!--循环行的每轮间隔(毫秒);未勾循环置灰不可填-->
                                            <TextBox Text="{Binding ControlDelay}" Grid.Column="3" Height="28" TextAlignment="Center"
                                                     IsEnabled="{Binding IsLoop}"/>
                                            <!--裸帧:勾选后地址格填完整请求帧文本原样发送,写入数据列不参与-->
                                            <CheckBox IsChecked="{Binding IsRawFrame}" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <!--循环:勾选后随监控自动循环写,点击无效;不勾=点击写一次-->
                                            <CheckBox IsChecked="{Binding IsLoop}" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock VerticalAlignment="Center">
                                                <Hyperlink Command="{Binding DataContext.SelectedDevice.DeleteManualControlCommand,ElementName=win}" CommandParameter="{Binding}">删除</Hyperlink>
                                                </TextBlock>
                                                <!--三点按钮:弹出数据类型切换(同变量配置样式)-->
                                                <ToggleButton Name="tbType" Margin="3,0,0,0" Style="{StaticResource PointMoreButtonStlye}" Width="20" Height="20"/>
                                                <Popup StaysOpen="False" IsOpen="{Binding ElementName=tbType,Path=IsChecked}" PlacementTarget="{Binding ElementName=tbType}" AllowsTransparency="True" VerticalOffset="2" HorizontalOffset="0">
                                                    <Border Background="#F7F9FA" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1" Margin="3">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="10" Opacity="0.1" Color="Gray" ShadowDepth="0"/>
                                                        </Border.Effect>
                                                        <Grid Margin="10,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="65"/>
                                                                <ColumnDefinition/>
                                                            </Grid.ColumnDefinitions>
                                                                <TextBlock Text="数据类型" Foreground="{DynamicResource App.Foreground}" VerticalAlignment="Center"/>
                                                            <ComboBox Height="26" Width="90" Style="{StaticResource PropComboBoxStyle}"
                                                                      ItemsSource="{Binding ElementName=win, Path=DataContext.TypeList}"
                                                                      SelectedValue="{Binding ValueType}" Grid.Column="1"/>
                                                        </Grid>
                                                    </Border>
                                                </Popup>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!--#endregion-->

                        <!--#region 变量报警配置-->
                        <Button Grid.Row="8" Style="{StaticResource ControlButtonStyle}" Height="30" Margin="5,3" HorizontalContentAlignment="Stretch" Tag="5" Command="{Binding AlarmConfCommand}">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="127*"/>
                                    <ColumnDefinition Width="63*"/>
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="变量报警配置" HorizontalAlignment="Left" Foreground="{DynamicResource App.Foreground}"/>
                                <TextBlock Text="&#xe720;" FontFamily="{StaticResource Iconfont}" HorizontalAlignment="Left" Grid.Column="1" Margin="52,0,0,0"/>
                            </Grid>
                        </Button>
                        <!--#endregion-->
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--下面的按钮-->
        <Border Background="{DynamicResource App.Background}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="42" CornerRadius="10"  Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#BBB" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>

            <Grid Width="260" TextBlock.Foreground="#999" TextBlock.FontSize="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!--切换按钮-->
                <ToggleButton Name="tb_component" IsChecked="True" Tag="10,0,0,10" Style="{StaticResource StateButtonStyle}" Margin="1">
                    <StackPanel>
                        <TextBlock Text="&#xe85e;" FontFamily="{StaticResource Iconfont}" HorizontalAlignment="Center" Margin="0,1"/>
                        <TextBlock Text="组件" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="1" Name="tb_property" IsChecked="True" Style="{StaticResource StateButtonStyle}" Margin="1">
                    <StackPanel>
                        <TextBlock Text="&#xe66e;" FontFamily="{StaticResource Iconfont}" HorizontalAlignment="Center" Margin="0,1"/>
                        <TextBlock Text="属性" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                    </StackPanel>
                </ToggleButton>
                <Button Grid.Column="3" Style="{StaticResource ControlButtonStyle}" Command="{Binding SaveDevicesCommand}" CommandParameter="{Binding ElementName=win}" Name="btnSave">
                    <StackPanel>
                        <TextBlock Text="&#xe63c;" FontFamily="{StaticResource Iconfont}" HorizontalAlignment="Center" Margin="0,1"/>
                        <TextBlock Text="保存" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource ControlButtonStyle}" Tag="0,10,10,0" Command="{Binding CloseCommand}" CommandParameter="{Binding ElementName=win}">
                    <StackPanel>
                        <TextBlock Text="&#xe695;" FontFamily="{StaticResource Iconfont}" HorizontalAlignment="Center" Margin="0,1"/>
                        <TextBlock Text="退出" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource App.Foreground}"/>
                    </StackPanel>
                </Button>
                
            </Grid>
        </Border>

        <!--保存成功-->
        <Border Background="{DynamicResource App.Background}" CornerRadius="10" Width="200" Height="45" VerticalAlignment="Top" Name="successbox" Margin="0,-80,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#DDD" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="&#xe60d;" FontFamily="{StaticResource Iconfont}" Foreground="LightGreen" VerticalAlignment="Center" FontSize="26" Margin="10,0"/>
                <TextBlock Text="设备数据保存完成！" Foreground="ForestGreen" VerticalAlignment="Center" FontSize="12" FontWeight="Normal"/>
            </StackPanel>
        </Border>

        <!--保存失败-->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center"  MinWidth="200" MaxWidth="350" Name="failedbox" Background="{DynamicResource App.Background}" CornerRadius="10" MinHeight="45" Margin="0,-80,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#DDD" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xe663;" FontFamily="{StaticResource Iconfont}" Foreground="OrangeRed" VerticalAlignment="Top" FontSize="26" Margin="10,13"/>
                <TextBox Text="{Binding SaveFailedMessage,StringFormat=设备数据保存失败！异常原因：{0}}" 
                         Grid.Column="1" Background="Transparent" MaxLength="10" Effect="{x:Null}"
                         Foreground="#555" VerticalAlignment="Stretch" FontSize="12" FontWeight="Normal" 
                         Style="{x:Null}" Margin="0,10" IsReadOnly="True" TextWrapping="Wrap" 
                         BorderThickness="0" BorderBrush="Transparent" VerticalContentAlignment="Center"/>

                <Button Content="&#xe653;" FontFamily="{StaticResource Iconfont}" 
                        Grid.Column="2" Height="20" Width="20" Margin="0,15"
                        Style="{StaticResource ControlButtonStyle}" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Command="{Binding CloseSaveFailedCommand}" CommandParameter="{Binding ElementName=win}"/>
            </Grid>
        </Border>

    </Grid>
</Window>
